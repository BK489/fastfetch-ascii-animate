// Animated skull config — boxed category layout
//
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "animate",
        "source": "/home/beckl/Projects/Skull_Animation/fastfetch/src/logo/animate-ascii/multicolour/",
        "width": 46,
        "color": {
            "1": "red",
            "2": "green"
        }
    },
    // ── Loading bars ────────────────────────────────────────────────────────
    // The bar engine: defines how {percentage-bar} / {size-percentage-bar}
    // render inside a module's format string. Both halves must be present —
    // this block alone shows nothing until a module format invokes the bar.
    "display": {
        "bar": {
            "border": {
                "left": "",
                "right": ""
            },
            "char": {
                "elapsed": "󰄮",
                "total": ""
            },
            "width": 10
        },
        "percent": {
            "type": 2,
            "color": {
                "green": "yellow",
                "yellow": "cyan"
            },
            "ndigits": 2
        }
    },
    "modules": [
        "title",
        "break",

        // ── Hardware ─────────────────────────────────────────────────────────
        {
            "type": "custom",
            "format": "\u001b[31m┌─󰫢─────────────────────Hardware───────────────────󰫢─┐\u001b[0m"
        },
        {
            "type": "host",
            "key": "󰌢 PC",
            "keyColor": "red"
        },
        {
            "type": "cpu",
            "key": "│ ├ 󰍛",
            "keyColor": "red",
            "temp": true
        },
        {
            "type": "gpu",
            "key": "│ ├ 󰢮",
            "keyColor": "red",
            "driverSpecific": true
        },
        {
            "type": "memory",
            "key": "│ ├ 󰑯",
            "keyColor": "red",
            "format": "{used} / {total} {percentage-bar}"
        },
        {
            "type": "disk",
            "key": "│ ├ 󰋊",
            "keyColor": "red",
            "format": "{size-used} / {size-total} {size-percentage-bar}"
        },
        {
            "type": "swap",
            "key": "│ ├ 󰁹 Swap",
            "keyColor": "red",
            "format": "{used} / {total} {percentage-bar}"
        },
        {
            "type": "display",
            "key": "│ ├ 󰍹 Display",
            "keyColor": "red"
        },
        {
            "type": "battery",
            "key": "└ └ 󰁺",
            "keyColor": "red"
        },
        {
            "type": "custom",
            "format": "\u001b[31m└─󰫢────────────────────────────────────────────────󰫢─┘\u001b[0m"
        },
        "break",

        // ── Software ─────────────────────────────────────────────────────────
        {
            "type": "custom",
            "format": "\u001b[32m┌─󰫢────────────────────Software───────────────────󰫢─┐\u001b[0m"
        },
        {
            "type": "users",
            "key": "󰈉 User",
            "keyColor": "green",
            "myselfOnly": true
        },
        {
            "type": "os",
            "key": "│ ├ 󰣇 OS",
            "keyColor": "green"
        },
        {
            "type": "kernel",
            "key": "│ ├ 󰒋",
            "keyColor": "green"
        },
        {
            "type": "packages",
            "key": "│ ├ 󰏖",
            "keyColor": "green"
        },
        {
            "type": "wm",
            "key": "│ ├ 󰧨 WM",
            "keyColor": "green"
        },
        {
            "type": "terminal",
            "key": "│ ├ 󰆍",
            "keyColor": "green"
        },
        {
            "type": "terminalfont",
            "key": "│ ├ 󰊀 TermFont",
            "keyColor": "green"
        },
        {
            "type": "shell",
            "key": "└ └ 󰇍",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "\u001b[32m└─󰫢───────────────────────────────────────────────󰫢─┘\u001b[0m"
        },
        "break",

        // ── Media & Misc ─────────────────────────────────────────────────────
        {
            "type": "custom",
            "format": "\u001b[35m┌─󰫢──────────────────Media & Misc──────────────────󰫢─┐\u001b[0m"
        },
        {
            "type": "uptime",
            "key": "󰅐 MISC",
            "keyColor": "magenta"
        },
        {
            "type": "sound",
            "key": "│ ├ 󰕿 Sound",
            "keyColor": "magenta",
            "percent": {
                "type": 9
            }
        },
        {
            "type": "player",
            "key": "│ ├ 󰝚 Player",
            "keyColor": "magenta"
        },
        {
            "type": "media",
            "key": "│ ├ 󰝚",
            "keyColor": "magenta"
        },
        {
            "type": "command",
            "key": "│ ├ 󰅼 OS Age",
            "keyColor": "magenta",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); Days_difference=$((time_progression / 86400)); echo $Days_difference Days",
            "format": "{result}"
        },
        {
            "type": "datetime",
            "key": "│ ├ 󰃭",
            "keyColor": "magenta"
        },
        {
            "type": "locale",
            "key": "└ └ 󰒋",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "\u001b[35m└─󰫢────────────────────────────────────────────────󰫢─┘\u001b[0m"
        },
        "break",

        {
            "type": "colors",
            "symbol": "star"
        }
    ]
}
